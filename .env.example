PORT=3000
MONGODB_URI=mongodb://localhost:27017/pre-cision
JWT_SECRET=replace_with_strong_secret
JWT_ACCESS_TOKEN_TTL=15m
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/github/oauth/callback
GITHUB_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Optional fallback; users can save their own key via PUT /api/v1/auth/gemini-key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768
VECTOR_INDEX_NAME=repo_vectors_index
GITHUB_WEBHOOK_SECRET=
# Public URL registered as the repo push webhook when a branch is indexed.
# Leave empty to index without a webhook (e.g. local dev without a tunnel).
GITHUB_WEBHOOK_URL=https://your-backend.example.com/api/v1/github/webhook
INDEX_MAX_FILES=500
# Frontend origin (CORS + OAuth redirect target)
FRONTEND_URL=http://localhost:5173
